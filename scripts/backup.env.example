# AI-Lawyer – Vorlage für /etc/ai-lawyer/backup.env (NICHT im Projektordner ablegen)
#
#   sudo install -d -m 700 /etc/ai-lawyer
#   sudo install -m 600 scripts/backup.env.example /etc/ai-lawyer/backup.env
#   sudo nano /etc/ai-lawyer/backup.env
#
# Format wie "docker run --env-file": KEY=wert pro Zeile, keine Anführungszeichen,
# kein "export", Kommentare nur als eigene Zeile. Das Repository-Passwort steht
# NICHT hier, sondern in /etc/ai-lawyer/backup.key (scripts/backup.sh init).

# ── Ziel (genau eines) ───────────────────────────────────────────────────────
# S3-kompatibel (z. B. Hetzner Object Storage, IONOS, Wasabi, AWS, eigenes MinIO
# an einem anderen Standort). Bucket vorher anlegen; Versionierung/Object Lock
# beim Anbieter einschalten, wenn verfügbar (Schutz gegen Löschen durch Angreifer).
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/BUCKETNAME/ai-lawyer
AWS_ACCESS_KEY_ID=BITTE_EINTRAGEN
AWS_SECRET_ACCESS_KEY=BITTE_EINTRAGEN
# AWS_DEFAULT_REGION=eu-central-1

# SFTP (z. B. NAS beim Kanzleiinhaber zu Hause, Hetzner Storage Box):
# Eigener SSH-Schlüssel ohne Passphrase in einem Ordner nur für die Sicherung
# (id_ed25519 + known_hosts, Rechte 700/600); er wird read-only als /root/.ssh
# in den restic-Container eingebunden. Schlüssel erzeugen und known_hosts füllen
# (Port in keyscan und RESTIC_REPOSITORY muss übereinstimmen; den Fingerabdruck
# mit dem vom Anbieter genannten vergleichen):
#   ssh-keygen -t ed25519 -N "" -C ai-lawyer-backup -f /etc/ai-lawyer/ssh/id_ed25519
#   ssh-keyscan -p 23 u123456.your-storagebox.de >> /etc/ai-lawyer/ssh/known_hosts
# Port 22 (Standard):  RESTIC_REPOSITORY=sftp:benutzer@host:/pfad/ai-lawyer
# anderer Port:        RESTIC_REPOSITORY=sftp://benutzer@host:PORT/ai-lawyer
#                      (Pfad relativ zum Heimatverzeichnis; absolut: PORT//pfad)
# Hetzner Storage Box (Port 23):
# RESTIC_REPOSITORY=sftp://u123456@u123456.your-storagebox.de:23/ai-lawyer
# BACKUP_SSH_DIR=/etc/ai-lawyer/ssh

# rest-server (eigener Server an anderem Ort, --append-only empfohlen):
# RESTIC_REPOSITORY=rest:https://backup.example.de:8000/ai-lawyer
# RESTIC_REST_USERNAME=ai-lawyer
# RESTIC_REST_PASSWORD=BITTE_EINTRAGEN

# ── Benachrichtigung (optional) ──────────────────────────────────────────────
# healthchecks.io-kompatibel: /start bei Beginn, URL bei Erfolg, /fail bei Fehler.
# Bleibt der Erfolgs-Ping aus, meldet der Dienst sich selbst (auch bei totem Server).
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/UUID

# ── Aufbewahrung und Prüfung (Standardwerte) ────────────────────────────────
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=5
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_YEARLY=0
# BACKUP_READ_DATA_SUBSET=auto
# BACKUP_INCLUDE_ENV=0
