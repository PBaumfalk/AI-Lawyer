# AI-Lawyer – Konfiguration
# Für Docker: ./setup.sh erzeugt diese Datei als .env mit zufälligen Geheimnissen.
# Von Hand: cp .env.example .env und alle Werte mit "ÄNDERN" ersetzen
# (z. B. openssl rand -hex 32). Vollständige Beschreibung: docs/handbuch/20-konfiguration.md

# ─── Adresse und Name ──────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
KANZLEI_NAME="Kanzlei"
# Für Browser erreichbare Adressen von MinIO (Downloads) und OnlyOffice (Editor)
MINIO_PUBLIC_URL="http://localhost:9000"
ONLYOFFICE_URL="http://localhost:8080"
# Netzwerkschnittstelle für App, OnlyOffice und MinIO (127.0.0.1 hinter Reverse Proxy)
PUBLIC_BIND="0.0.0.0"

# ─── Geheimnisse (Pflicht) ─────────────────────────────────────────────────────
NEXTAUTH_SECRET="ÄNDERN"
EMAIL_ENCRYPTION_KEY="ÄNDERN-mindestens-32-zeichen"
ONLYOFFICE_SECRET="ÄNDERN"
POSTGRES_PASSWORD="ÄNDERN"
REDIS_PASSWORD="ÄNDERN"
MINIO_ACCESS_KEY="ailawyer"
MINIO_SECRET_KEY="ÄNDERN"
MEILISEARCH_API_KEY="ÄNDERN"

# ─── Erstes Administratorkonto (nur beim allerersten Start) ───────────────────
# Ohne INITIAL_ADMIN_PASSWORD erzeugt der erste Start ein Zufallspasswort und
# schreibt es einmalig ins Log (docker compose logs app). Mindestens 12 Zeichen.
INITIAL_ADMIN_EMAIL="admin@kanzlei.de"
INITIAL_ADMIN_PASSWORD="ÄNDERN"
# Beispielkonten und Beispielakte (Passwort password123) – nur zum Ausprobieren
SEED_DEMO="false"

# Anmeldeschutz: Anzahl vertrauenswürdiger Reverse-Proxys (Caddy, nginx, Traefik)
# direkt vor der App. 0 = App ist direkt erreichbar, X-Forwarded-For wird ignoriert.
# Mit Proxy 1 setzen; der Proxy muss X-Forwarded-For anhängen.
TRUST_PROXY_HOPS="0"
# Optional, Standardwerte: LOGIN_LIMIT_QUELLE_KONTO=10, LOGIN_LIMIT_QUELLE=100,
# LOGIN_LIMIT_KONTO_GESAMT=50, LOGIN_LIMIT_TOTP=10, LOGIN_LIMIT_FENSTER_SEKUNDEN=900,
# LIMITER_TIMEOUT_MS=500, LIMITER_CONNECT_WAIT_MS=1000

# ─── KI: Startwerte beim allerersten Start ─────────────────────────────────────
# Danach gilt ausschließlich Einstellungen → KI in der Oberfläche.
AI_PROVIDER="ollama"          # ollama | openai | anthropic
AI_MODEL=""                   # leer = Standard des Anbieters
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Helena Datei-Pipeline: anymize (Anonymisierung vor der KI). Besser in
# Einstellungen → KI eintragen, dort wird der Schlüssel verschlüsselt gespeichert.
ANYMIZE_API_KEY=""

# ─── Optional ──────────────────────────────────────────────────────────────────
# Rollen mit Pflicht zur Zwei-Faktor-Anmeldung, z. B. "ADMIN,ANWALT"
TOTP_REQUIRED_ROLES=""
# E-Mail-Versand für Fristerinnerungen und Portal-Einladungen (leer = aus)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
LOG_LEVEL="info"
WORKER_CONCURRENCY="5"
# j-lawyer.org im eigenen Netz für die Migration erlauben
JLAWYER_ALLOW_PRIVATE_URLS=""
# Token für das OpenClaw-Agenten-Gateway (leer = Schnittstelle gesperrt)
OPENCLAW_GATEWAY_TOKEN=""
# Anderes MinIO-Image (z. B. eigener Mirror)
# MINIO_IMAGE="cgr.dev/chainguard/minio:latest"

# ─── Nur lokale Entwicklung (npm run dev, ohne Docker) ─────────────────────────
DATABASE_URL="postgresql://ailawyer:ÄNDERN@localhost:5432/ailawyer?schema=public"
REDIS_URL="redis://:ÄNDERN@localhost:6379"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_BUCKET="dokumente"
MINIO_USE_SSL="false"
MEILISEARCH_URL="http://localhost:7700"
ONLYOFFICE_INTERNAL_URL="http://localhost:8080"
APP_INTERNAL_URL="http://host.docker.internal:3000"
STIRLING_PDF_URL="http://localhost:8081"
OLLAMA_URL="http://localhost:11434"
# Einbettungsmodell: muss 1024-dimensionale Vektoren liefern (Datenbankspalten vector(1024))
EMBEDDING_MODEL="blaifa/multilingual-e5-large-instruct"

# ─── beA (bea.expert) ──────────────────────────────────────────────────────────
# Ident aus dem bea.expert-Vertrag. Ohne Ident ist beA in Produktion abgeschaltet
# ("beA ist nicht eingerichtet"). Die API-URL steht in der Einstellung bea.api_url.
# BEA_EXPERT_IDENT=""
# Anbieter: expert (echte Anbindung, Standard bei gesetztem Ident) oder mock
# (Testdaten, nur außerhalb von Produktion). Handbuch Kapitel 8.
# BEA_PROVIDER="expert"

# ─── Datensicherung ───────────────────────────────────────────────────────────
# Ziel, Zugangsdaten und Schlüssel der Sicherung stehen bewusst NICHT hier,
# sondern außerhalb des Projektordners: /etc/ai-lawyer/backup.env (Vorlage:
# scripts/backup.env.example) und /etc/ai-lawyer/backup.key (scripts/backup.sh init).
# Diese .env selbst getrennt verwahren (Passwortmanager/Tresor), vor allem
# EMAIL_ENCRYPTION_KEY – ohne ihn ist eine Wiederherstellung unvollständig.
# Handbuch Kapitel 21.
